# Apenas os arquivos necessarios para instalar o pacote entram no build.
# Impede o envio de PDFs, credenciais, caches e repositorios ao build.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!src/
!src/**
# Exclusoes explicitas prevalecem inclusive dentro de src/.
.git/
.venv/
**/.git/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/*.py[cod]
**/*.egg-info/
**/*.[pP][dD][fF]
data/
output/
outputs/
tests/
scripts/
**/*.tmp
**/*.temp
**/*.log
**/.DS_Store
**/Thumbs.db
